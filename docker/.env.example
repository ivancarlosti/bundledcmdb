# Bundled CMDB environment template.
#
#   cp .env.example .env    # then edit the values below
#
# `.env` is git-ignored. docker-compose.yml (external database) reads the DB_*
# values below; docker-compose-bundle.yml creates its own MariaDB and uses the
# BUNDLE_DB_* variables documented in that file. S3/object storage has no
# environment tier any more: configure it once in Settings → Storage (the
# secret is encrypted with APP_ENCRYPTION_KEY).

# Database Settings (docker-compose.yml: external database)
DB_SERVER=host.docker.internal
DB_PORT=
DB_NAME=YOURDBNAME
DB_USERNAME=YOURDBUSERNAME
DB_PASSWORD=YOURDBPASSWORD

# Application
# 32-byte key used to encrypt secrets saved in the panel (e.g. the S3 secret
# key). Without it secrets are stored with a `plain:` prefix and the panel
# warns. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Optional fallbacks; the Settings page overrides them once saved.
APP_DEFAULT_LOCALE=pt-BR
APP_TIMEZONE=America/Sao_Paulo
# Empty = report manifest.json's version (the released tag). Only set this to
# override, e.g. for a locally built image.
APP_VERSION=
# Local development only (never in production): enables /auth/dev-login.
# APP_ENV=development
# APP_DEV_LOGIN=1

# Keycloak Settings
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=YOURSSORealm
KEYCLOAK_CLIENT_ID=bundledcmdb
KEYCLOAK_CLIENT_SECRET=YOURKEYCLOAKCLIENTSECRET
KEYCLOAK_REDIRECT_URI=https://bundledcmdb.example.com/index.php
