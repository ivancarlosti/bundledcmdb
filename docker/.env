# Database Settings
DB_SERVER=host.docker.internal
DB_PORT=
DB_NAME=YOURDBNAME
DB_USERNAME=YOURDBUSERNAME
DB_PASSWORD=YOURDBPASSWORD

# Application
# 32-byte key used to encrypt secrets saved in the panel (S3 secret key).
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Optional fallbacks; the Settings page overrides them once saved.
APP_DEFAULT_LOCALE=pt-BR
APP_TIMEZONE=America/Sao_Paulo
# Empty = report manifest.json's version (the released tag). Only set this to
# override, e.g. for a locally built image.
APP_VERSION=

# S3 Settings (fallbacks only: prefer Settings -> Storage, which encrypts the
# secret; values here are used until a database value is saved)
S3_REGION=YOURS3REGION
S3_BUCKET=YOURS3BUCKET
S3_ACCESS_KEY=YOURS3ACCESSKEY
S3_SECRET_KEY=YOURS3SECRETKEY
S3_ENDPOINT=https://s3.YOURS3REGION.amazonaws.com

# Keycloak Settings
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=YOURSSORealm
KEYCLOAK_CLIENT_ID=bundledcmdb
KEYCLOAK_CLIENT_SECRET=YOURKEYCLOAKCLIENTSECRET
KEYCLOAK_REDIRECT_URI=https://bundledcmdb.example.com/index.php
